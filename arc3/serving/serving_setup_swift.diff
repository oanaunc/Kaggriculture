+def _safetensors_header(path: Path) -> tuple[dict[str, Any], int]:
+    with path.open("rb") as handle:
+        prefix = handle.read(8)
+        if len(prefix) != 8:
+            raise RuntimeError(f"Truncated safetensors file: {path}")
+        (header_len,) = struct.unpack("<Q", prefix)
+        if header_len <= 0 or header_len > 64 * 1024 * 1024:
+            raise RuntimeError(f"Implausible safetensors header length {header_len}: {path}")
+        header = json.loads(handle.read(header_len))
+    return header, 8 + header_len
+
