+def _fp8_e4m3fn_to_float32_table(np: Any) -> Any:
+    codes = np.arange(256, dtype=np.int64)
+    sign = np.where((codes >> 7) & 1, -1.0, 1.0)
+    exponent = (codes >> 3) & 0xF
+    mantissa = (codes & 0x7).astype(np.float64)
+    normal = (1.0 + mantissa / 8.0) * np.exp2(exponent.astype(np.float64) - 7.0)
+    subnormal = (mantissa / 8.0) * 2.0**-6
+    values = sign * np.where(exponent == 0, subnormal, normal)
+    values[(exponent == 0xF) & ((codes & 0x7) == 0x7)] = np.nan
+    return values.astype(np.float32)
+
+
+def _bf16_bits_to_float32(np: Any, bits: Any) -> Any:
+    return (bits.astype(np.uint32) << np.uint32(16)).view(np.float32)
+
+
+def _float32_to_bf16_bits(np: Any, values: Any) -> Any:
+    """Round-to-nearest-even float32 -> bfloat16 bit patterns (finite inputs)."""
+
+    if not np.isfinite(values).all():
+        raise RuntimeError("Non-finite value while dequantizing the MTP experts.")
+    bits = np.ascontiguousarray(values, dtype=np.float32).view(np.uint32)
+    rounding = np.uint32(0x7FFF) + ((bits >> np.uint32(16)) & np.uint32(1))
+    return ((bits + rounding) >> np.uint32(16)).astype(np.uint16)
+
+
+def dequantize_fp8_block(
+    np: Any,
+    table: Any,
+    weight_codes: Any,
+    scale_bits: Any,
+    block: int = SWIFT_MTP_BLOCK,
+) -> Any:
+    """ModelOpt FP8_PB_WO / DeepSeek weight_scale_inv: w = fp8 * scale per block."""
+
+    rows, cols = weight_codes.shape
+    expected = (-(-rows // block), -(-cols // block))
+    if tuple(scale_bits.shape) != expected:
+        raise RuntimeError(f"Unexpected block scale shape {scale_bits.shape} for {weight_codes.shape}")
+    scale = _bf16_bits_to_float32(np, scale_bits)
+    expanded = np.repeat(np.repeat(scale, block, axis=0), block, axis=1)[:rows, :cols]
+    return _float32_to_bf16_bits(np, table[weight_codes] * expanded)
